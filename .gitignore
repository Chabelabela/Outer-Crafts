# Hide every root-level file/dir except source and essential build infrastructure.
# AI guides, scratch scripts, PDFs, backup dirs, etc. stay local — not for the public repo.
/*
!/.gitignore
!/build.gradle
!/gradle/
!/gradle.properties
!/gradlew
!/gradlew.bat
!/settings.gradle
!/src/

# These can show up anywhere in the tree — keep them ignored regardless
.DS_Store
hs_err_pid*
*.iml
